# Application
APP_NAME="Digital FTE Agent"
APP_VERSION="1.0.0"
ENV="development"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5434/digital_fte"

# Redis (Event Bus)
REDIS_URL="redis://localhost:6380/0"
REDIS_PASSWORD=""

# Orchestrator
ORCHESTRATOR_URL="http://localhost:8000"
AGENT_TOKEN=""

# JWT Auth
SECRET_KEY="replace-with-a-very-strong-secret-key-32-chars-minimum"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=""

# CORS & Frontend
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:8000"
FRONTEND_SUCCESS_URL="http://localhost:3000/dashboard"

# Email SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# LLM & Encryption
LLM_API_KEY=""
LLM_MODEL="gemini-2.0-flash-exp"
ENCRYPTION_KEY=""

# Platform OAuth
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,read_orders"
SHOPIFY_REDIRECT_URI="http://localhost:8000/api/v1/auth/shopify/callback"

WOOCOMMERCE_REDIRECT_URI="http://localhost:8000/api/v1/auth/woocommerce/callback"

BIGCOMMERCE_CLIENT_ID=""
BIGCOMMERCE_CLIENT_SECRET=""
BIGCOMMERCE_REDIRECT_URI="http://localhost:8000/api/v1/auth/bigcommerce/callback"

AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_REDIRECT_URI="http://localhost:8000/api/v1/auth/amazon/callback"
AMAZON_REFRESH_TOKEN=""

DARAZ_APP_KEY=""
DARAZ_APP_SECRET=""
DARAZ_REDIRECT_URI="http://localhost:8000/api/v1/auth/daraz/callback"

# Content & Social
GEMINI_API_KEY=""
DALLE_API_KEY=""
IMAGE_MODEL_DEFAULT="gemini-2.0-flash-exp"

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ─── Customer Support Agent (Claude) ───────────────────────────
# Required for the storefront chat. Model name is read only from here.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_MAX_TOKENS=1024
CHAT_MAX_TOOL_ROUNDS=6
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Shown next to prices when set, e.g. "PKR" (variants store no currency)
STORE_CURRENCY=""

# Shopify Admin API (GraphQL) version for order lookups.
# Store access token needs read_orders (read_all_orders for orders > 60 days old)
# and protected-customer-data access so order email/phone can be verified.
SHOPIFY_API_VERSION="2024-01"

# Handoff notifications to the business owner (set one or both).
# Email uses the SMTP_* settings above; the webhook receives JSON {text, subject, handoff}.
OWNER_NOTIFY_EMAIL=""
OWNER_WEBHOOK_URL=""
